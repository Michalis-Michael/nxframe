{
  "_gui": {
    "id": "lowest_latency_interview",
    "name": "Lowest latency (interview)",
    "description": "Deterministic x264 contribution preset for interviews and two-way links where acquisition and latency matter more than compression efficiency.",
    "version": 3,
    "order": 30,
    "default_protocol": "srt",
    "mpegts_auto": true,
    "vbv_buffer_seconds": 0.5,
    "vbr_maxrate_multiplier": 1.25
  },
  "codec": "x264",
  "width": 1920,
  "height": 1080,
  "framerate": 25,
  "bitrate": 15000000,
  "vbv-maxrate": 15000000,
  "vbv_bufsize": 7500000,
  "mpegts": {
    "service_provider": "NxFrame",
    "service_name": "Lowest Latency Interview",
    "muxrate": 16400000,
    "null_stuffing": true
  },
  "gop": {
    "size": 50,
    "min_keyint": 50,
    "scenecut": 0,
    "closed": true
  },
  "max_b_frames": 0,
  "preset": "medium",
  "tune": "zerolatency",
  "profile": "high422",
  "interlaced": true,
  "field_order": "tff",
  "output": {
    "bit_depth": 10,
    "chroma": "422"
  },
  "color": {
    "primaries": "bt709",
    "transfer": "bt709",
    "matrix": "bt709",
    "range": "limited",
    "chroma_location": "left"
  },
  "audio": {
    "mode": "encode",
    "codec": "aac_lc_mpeg4",
    "layout": "split_pairs",
    "input_channels": 16,
    "pairs": [
      {
        "name": "Pair 1",
        "channels": [1, 2],
        "type": "aac_lc_mpeg4",
        "standard": "mpeg4"
      },
      {
        "name": "Pair 2",
        "channels": [3, 4],
        "type": "aac_lc_mpeg4",
        "standard": "mpeg4"
      }
    ],
    "sample_rate": 48000,
    "bitrate": 192000,
    "profile": "aac_low",
    "standard": "mpeg4",
    "transport": "adts"
  },
  "srt": {
    "mode": "listener",
    "address": "0.0.0.0",
    "bind_address": "0.0.0.0",
    "port": 5000,
    "latency": 120,
    "payload_size": 1316,
    "tlpktdrop": true,
    "messageapi": true,
    "streamid": "",
    "passphrase": "",
    "pbkeylen": 0,
    "maxbw": 0,
    "inputbw": 0,
    "oheadbw": 25,
    "connect_timeout_ms": 3000,
    "reconnect_attempts": 5,
    "reconnect_delay_ms": 1000,
    "send_timeout_ms": 1000,
    "recv_timeout_ms": 1000,
    "sndbuf": 16777216,
    "rcvbuf": 16777216
  },
  "additional_options": {
    "rate_control": "cbr",
    "nal-hrd": "cbr",
    "filler": 1,
    "level": "4.0",
    "vbv-init": 0.9,
    "threads": 0,
    "sync-lookahead": 0,
    "rc-lookahead": 0,
    "weightp": 0,
    "fast-pskip": 1,
    "dct-decimate": 1,
    "ref": 2,
    "subme": 2,
    "trellis": 0,
    "me": "hex",
    "merange": 16
  }
}
