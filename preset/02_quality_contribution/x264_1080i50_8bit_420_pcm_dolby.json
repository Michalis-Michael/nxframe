{
  "codec": "x264",
  "width": 1920,
  "height": 1080,
  "framerate": 25,

  "bitrate": 14500000,
  "vbv-maxrate": 14500000,
  "vbv_bufsize": 29000000,

  "mpegts": {
    "service_provider": "NxFrame",
    "service_name": "NxFrame F1 Style HD",
    "muxrate": 25000000,
     "null_stuffing": true
  },

  "gop": {
    "size": 50,
    "min_keyint": 25,
    "scenecut": 0,
    "closed": true
  },

  "max_b_frames": 0,
  "preset": "medium",
  "profile": "high",

  "interlaced": true,
  "field_order": "tff",

  "output": {
    "bit_depth": 8,
    "chroma": "420"
  },

  "color": {
    "primaries": "bt709",
    "transfer": "bt709",
    "matrix": "bt709",
    "range": "limited",
    "chroma_location": "left"
  },

  "audio": {
    "mode": "pcm",
    "codec": "pcm",
    "layout": "split_pairs",
    "input_channels": 8,
    "pairs": [
      {
        "name": "Pair 1",
        "channels": [1, 2],
        "type": "pcm"
      },
      {
        "name": "Pair 2",
        "channels": [3, 4],
        "type": "pcm"
      },
      {
        "name": "Dolby E",
        "channels": [5, 6],
        "type": "dolby_e",
        "bit_depth": 20
      }
    ],
    "sample_rate": 48000
  },

  "srt": {
    "mode": "listener",
    "latency": 250,
    "payload_size": 1316,
    "tlpktdrop": true,
    "messageapi": true,
    "oheadbw": 50,
    "connect_timeout_ms": 3000,
    "reconnect_attempts": 5,
    "reconnect_delay_ms": 1000,
    "send_timeout_ms": 1000,
    "recv_timeout_ms": 1000,
    "sndbuf": 16777216,
    "rcvbuf": 16777216
  },

"additional_options": {
  "rate_control": "cbr",
  "nal-hrd": "cbr",
  "filler": 1,
  "level": "4.0",
  "vbv-init": 0.9,
  
  "bframes": 0,
  "b-adapt": 0,
  "b-pyramid": "none",

  "threads": 0,
  "sync-lookahead": 0,
  "rc-lookahead": 25,

  "aud": 1,
  "pic-struct": 1,

  "weightp": 0,
  "fast-pskip": 0,
  "dct-decimate": 0,

  "ref": 4,
  "subme": 7,
  "trellis": 2,
  "me": "hex",
  "merange": 24,

  "aq-mode": 1,
  "aq-strength": 0.9,
  "psy-rd": "1.0:0.15",
  "deblock": "-1:-1"
}
}
